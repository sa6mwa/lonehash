set(_lh_target "${LONEHASH_TARGET_ID}")
if(_lh_target STREQUAL "" AND NOT "$ENV{LONEHASH_TARGET_ID}" STREQUAL "")
  set(_lh_target "$ENV{LONEHASH_TARGET_ID}")
endif()
if(_lh_target STREQUAL "")
  message(FATAL_ERROR "LONEHASH_TARGET_ID is required for all lifecycle presets")
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LONEHASH_TARGET_ID)

get_filename_component(_lh_project_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(_lh_resolver "${_lh_project_root}/scripts/cpkt-toolchains.sh")
if(NOT EXISTS "${_lh_resolver}")
  message(FATAL_ERROR "missing lifecycle toolchain resolver: ${_lh_resolver}")
endif()

function(_lh_resolve_toolchain_value key output)
  string(REGEX MATCH "(^|\n)${key}=([^\r\n]+)" _lh_match "${_lh_description}")
  if(NOT _lh_match)
    message(FATAL_ERROR "toolchain resolver did not report ${key} for ${_lh_target}")
  endif()
  set(${output} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

if(_lh_target STREQUAL "arm64-apple-darwin")
  execute_process(
    COMMAND "${_lh_resolver}" discover "${_lh_target}"
    RESULT_VARIABLE _lh_result
    OUTPUT_VARIABLE _lh_description
    ERROR_VARIABLE _lh_error)
  if(NOT _lh_result EQUAL 0 OR NOT _lh_description MATCHES "status=ready")
    message(FATAL_ERROR "Darwin toolchain is unavailable for ${_lh_target}: ${_lh_error}${_lh_description}")
  endif()
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR arm64)
else()
  execute_process(
    COMMAND "${_lh_resolver}" ensure "${_lh_target}"
    RESULT_VARIABLE _lh_result
    OUTPUT_VARIABLE _lh_ensure_output
    ERROR_VARIABLE _lh_error)
  if(NOT _lh_result EQUAL 0)
    message(FATAL_ERROR "Unable to provision pinned ${_lh_target} toolchain: ${_lh_error}${_lh_ensure_output}")
  endif()
  execute_process(
    COMMAND "${_lh_resolver}" discover "${_lh_target}"
    RESULT_VARIABLE _lh_result
    OUTPUT_VARIABLE _lh_description
    ERROR_VARIABLE _lh_error)
  if(NOT _lh_result EQUAL 0 OR NOT _lh_description MATCHES "status=ready")
    message(FATAL_ERROR "Unable to inspect pinned ${_lh_target} toolchain: ${_lh_error}${_lh_description}")
  endif()
  set(CMAKE_SYSTEM_NAME Linux)
  if(_lh_target MATCHES "^x86_64-")
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
  elseif(_lh_target MATCHES "^aarch64-")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
  elseif(_lh_target MATCHES "^armhf-")
    set(CMAKE_SYSTEM_PROCESSOR arm)
  else()
    message(FATAL_ERROR "unsupported LONEHASH_TARGET_ID=${_lh_target}")
  endif()
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
endif()

foreach(_lh_key cc cxx ld ar ranlib strip nm)
  _lh_resolve_toolchain_value(${_lh_key} _lh_${_lh_key})
endforeach()
if(NOT _lh_target STREQUAL "arm64-apple-darwin")
  foreach(_lh_key objcopy objdump addr2line readelf sysroot root)
    _lh_resolve_toolchain_value(${_lh_key} _lh_${_lh_key})
  endforeach()
endif()
if(_lh_target STREQUAL "arm64-apple-darwin")
  _lh_resolve_toolchain_value(otool _lh_otool)
endif()

set(CMAKE_C_COMPILER "${_lh_cc}" CACHE FILEPATH "lifecycle C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${_lh_cxx}" CACHE FILEPATH "lifecycle C++ compiler" FORCE)
set(CMAKE_LINKER "${_lh_ld}" CACHE FILEPATH "lifecycle linker" FORCE)
set(CMAKE_AR "${_lh_ar}" CACHE FILEPATH "lifecycle archiver" FORCE)
set(CMAKE_RANLIB "${_lh_ranlib}" CACHE FILEPATH "lifecycle ranlib" FORCE)
set(CMAKE_STRIP "${_lh_strip}" CACHE FILEPATH "lifecycle strip" FORCE)
set(CMAKE_NM "${_lh_nm}" CACHE FILEPATH "lifecycle nm" FORCE)
if(NOT _lh_target STREQUAL "arm64-apple-darwin")
  set(CMAKE_OBJCOPY "${_lh_objcopy}" CACHE FILEPATH "lifecycle objcopy" FORCE)
  set(CMAKE_OBJDUMP "${_lh_objdump}" CACHE FILEPATH "lifecycle objdump" FORCE)
  set(CMAKE_ADDR2LINE "${_lh_addr2line}" CACHE FILEPATH "lifecycle addr2line" FORCE)
endif()

if(_lh_target STREQUAL "arm64-apple-darwin")
  get_filename_component(_lh_bin_dir "${_lh_cc}" DIRECTORY)
  set(ENV{PATH} "${_lh_bin_dir}:$ENV{PATH}")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${_lh_ld}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "--ld-path=${_lh_ld}")
  set(CMAKE_MODULE_LINKER_FLAGS_INIT "--ld-path=${_lh_ld}")
  set(CMAKE_OTOOL "${_lh_otool}" CACHE FILEPATH "lifecycle otool" FORCE)
  get_filename_component(_lh_cc_name "${_lh_cc}" NAME)
  string(REGEX REPLACE "-clang$" "" _lh_darwin_host "${_lh_cc_name}")
  set(CMAKE_INSTALL_NAME_TOOL "${_lh_bin_dir}/${_lh_darwin_host}-install_name_tool"
      CACHE FILEPATH "lifecycle install-name tool" FORCE)
else()
  set(CMAKE_READELF "${_lh_readelf}" CACHE FILEPATH "lifecycle readelf" FORCE)
  set(CMAKE_SYSROOT "${_lh_sysroot}" CACHE PATH "lifecycle sysroot" FORCE)
  set(CMAKE_FIND_ROOT_PATH "${_lh_sysroot}" "${_lh_root}" CACHE STRING "lifecycle find roots" FORCE)
  set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER CACHE STRING "" FORCE)
  set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY CACHE STRING "" FORCE)
  set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY CACHE STRING "" FORCE)
  set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY CACHE STRING "" FORCE)
endif()
